# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Any NEXT_DIST_DIR build (mock server, pre-commit build, one-off repro). Not
# just untracked-noise: Tailwind v4 scans every non-ignored file for candidate
# classes, so a stray dist dir feeds it minified chunks — one corrupt byte in
# there becomes "Parsing CSS source code failed" and a 500 on every page.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# eslint (кеш ускоряет повторные прогоны, машинно-зависимый)
.eslintcache

# typescript
*.tsbuildinfo
next-env.d.ts
.idea/
.output.txt

# ── GSD baseline (auto-generated) ──
.gsd
.gsd-id
.bg-shell/
Thumbs.db
*.swp
*.swo
*~
.vscode/
*.code-workspace
.env
.env.*
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
coverage/
.cache/
tmp/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# ── GSD baseline (auto-generated) ──
.mcp.json

