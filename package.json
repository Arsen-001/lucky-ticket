{
  "name": "lucky-ticket",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:nocache": "eslint .",
    "format": "npx prettier . --write",
    "clean": "rm -rf .next ",
    "rnm": "rm -rf node_modules",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "e2e:prod-server": "NEXT_PUBLIC_API_URL= NEXT_DIST_DIR=.next-e2e-prod next build && NEXT_PUBLIC_API_URL= NEXT_DIST_DIR=.next-e2e-prod next start --port 3100",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.0",
    "@tonconnect/ui-react": "^3.0.0",
    "dayjs": "^1.11.19",
    "js-cookie": "^3.0.8",
    "lucide-react": "^0.555.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.68.0",
    "react-phone-number-input": "^3.4.14",
    "react-redux": "^9.2.0",
    "swiper": "12.1.2",
    "tailwind-merge": "^3.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "3.7.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier -w"
    ],
    "*.{json,css,md}": [
      "prettier -w"
    ]
  }
}
