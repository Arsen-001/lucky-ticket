NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_BASE_API=https://api.example.com
NEXT_PUBLIC_APP_URL=https://api.example.com

# Rewarded ads (Tasks → Ads). With every id blank the mock/dev flow stays on.
# Full setup for each network — see DOCS/ADS_SETUP.md.

# Adsgram block id (from the Adsgram publisher account).
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=
# Set to "true" to serve Adsgram test ads while integrating (disables S2S reward).
NEXT_PUBLIC_ADSGRAM_DEBUG=false

# Monetag Rewarded Interstitial zone id (from the Monetag publisher account).
NEXT_PUBLIC_MONETAG_ZONE_ID=

# Waterfall order. One ad per action: the next network is only tried after the
# previous returned nothing. `house` is the app's own promo and always fills,
# so keep it last. Blank = adsgram,monetag,house.
NEXT_PUBLIC_AD_PROVIDERS=
