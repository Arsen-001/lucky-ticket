NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_BASE_API=https://api.example.com
NEXT_PUBLIC_APP_URL=https://api.example.com

# Public origin of this deployment — the base for absolute URLs handed to third
# parties (social-card / icon URLs, the TON Connect manifest). Blank falls back
# to Vercel's own production domain, so only set it for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Pre-launch gate (the `production` branch only — see
# src/config/coming-soon.config.ts). On that branch the gate is ON by default:
# the root layout serves the Coming Soon screen and the app never boots. Set to
# 0 to browse the real app off the branch without a code change.
NEXT_PUBLIC_COMING_SOON=
# The instant the countdown counts down to, as an absolute date. Blank uses the
# date bundled in the config, so moving launch = edit this here + redeploy.
NEXT_PUBLIC_LAUNCH_AT=

# Rewarded ads (Tasks → Ads). With every id blank the mock/dev flow stays on.
# Full setup for each network — see DOCS/ADS_SETUP.md.

# Adsgram block id (from the Adsgram publisher account).
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=
# Set to "true" to serve Adsgram test ads while integrating (disables S2S reward).
NEXT_PUBLIC_ADSGRAM_DEBUG=false

# Monetag Rewarded Interstitial zone id (from the Monetag publisher account).
NEXT_PUBLIC_MONETAG_ZONE_ID=

# Waterfall order. One ad per action: the next network is only tried after the
# previous returned nothing. `house` is the app's own promo and always fills,
# so keep it last. Blank = adsgram,monetag,house. Production runs `adsgram,house`
# — a network dropped from this list is not called and its SDK is not even
# loaded, so putting it back needs only an edit here plus a redeploy.
NEXT_PUBLIC_AD_PROVIDERS=adsgram,house
