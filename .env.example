NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_BASE_API=https://api.example.com
NEXT_PUBLIC_APP_URL=https://api.example.com

# Public origin of this deployment — the base for absolute URLs handed to third
# parties (social-card / icon URLs, the TON Connect manifest). Blank falls back
# to Vercel's own production domain, so only set it for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Rewarded ads (Tasks → Ads). With every id blank the mock/dev flow stays on.
# Full setup for each network — see DOCS/ADS_SETUP.md.

# Adsgram block id (from the Adsgram publisher account).
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=
# Set to "true" to serve Adsgram test ads while integrating (disables S2S reward).
NEXT_PUBLIC_ADSGRAM_DEBUG=false

# Monetag Rewarded Interstitial zone id (from the Monetag publisher account).
NEXT_PUBLIC_MONETAG_ZONE_ID=

# RichAds — both ids come from the publisher account (Traffic sources →
# Telegram Mini App). Either one missing skips the network entirely, script
# included. RichAds has NO server-to-server postback, so its views are credited
# on the client's word — keep it last in the waterfall.
NEXT_PUBLIC_RICHADS_PUB_ID=
NEXT_PUBLIC_RICHADS_APP_ID=
# Set to "true" to serve RichAds test creatives while integrating.
NEXT_PUBLIC_RICHADS_DEBUG=false

# Waterfall order — real ad networks only. One ad per action: the next network
# is only tried after the previous returned nothing, and when all of them are
# empty the player gets ONE modal naming the reason (17.08.2026 — the app's own
# promo no longer stands in for a missing video). Blank = adsgram,monetag,richads.
# A network dropped from this list is not called and its SDK is not even loaded,
# so putting it back needs only an edit here plus a redeploy; a leftover `house`
# entry is ignored. A network that just answered "no fill" is moved to the BACK
# of the chain for five minutes — demoted, never dropped, so an empty chain can
# never reach the dev/mock path that grants outright.
NEXT_PUBLIC_AD_PROVIDERS=adsgram,monetag
# How many views in a row go to ONE network before the chain rotates to the
# next. With a strict waterfall (0) the top network serves nearly everything —
# Adsgram fills 97% on production, so the second one is asked about twice per
# hundred views: too little to earn from, and far too little to ever compare
# against (the panel refuses a verdict under 1000 views per network). Rotating
# also keeps a viewer's later views away from a pool that has already been
# frequency-capped, which is where per-view revenue collapses — so 1, not 2:
# two views in a row already spend the second on demand the first one dented.
NEXT_PUBLIC_AD_ROTATE_EVERY=1

