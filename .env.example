NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_BASE_API=https://api.example.com
NEXT_PUBLIC_APP_URL=https://api.example.com

# Adsgram rewarded ads (Tasks → Ads). Leave blank to keep the mock/dev flow.
# Get the block id from the Adsgram publisher account — see DOCS/ADSGRAM_SETUP.md.
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=
# Set to "true" to serve Adsgram test ads while integrating (disables S2S reward).
NEXT_PUBLIC_ADSGRAM_DEBUG=false
