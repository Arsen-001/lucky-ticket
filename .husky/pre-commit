#!/usr/bin/env sh
set -e

echo "[husky] Running pre-commit checks..."

# 1) Clean the ISOLATED pre-commit build dir (never `.next` itself — a
# running `next dev` serves from it, and nuking it mid-session breaks the
# dev server until restart).
rm -rf .next-precommit

# 2) Lint and format staged files only
npx lint-staged
if [ $? -ne 0 ]; then
  echo "[husky] lint-staged failed. Aborting commit."
  exit 1
fi

# 3) Type check the project
npm run type-check
if [ $? -ne 0 ]; then
  echo "[husky] Type checking failed. Aborting commit."
  exit 1
fi

# 4) Run the unit + guardrail test suite (fast, no browser)
npm test
if [ $? -ne 0 ]; then
  echo "[husky] Tests failed. Aborting commit."
  exit 1
fi

# 5) Ensure the project builds before committing — into the isolated dir,
# so the dev server's `.next` stays untouched.
NEXT_DIST_DIR=.next-precommit npm run build
if [ $? -ne 0 ]; then
  echo "[husky] Build failed. Aborting commit."
  exit 1
fi
rm -rf .next-precommit

echo "[husky] All checks passed. Proceeding with commit."
